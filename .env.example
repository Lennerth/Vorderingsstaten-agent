AZURE_OPENAI_API_KEY=<your-azure-key>
LOG_DIR=logs
# Flemish bestek (Vlaams) — run: python -m scripts.init_kb --region flemish
VECTOR_STORE_ID_FLEMISH=
# Walloon CCTB — run: python -m scripts.build_walloon_master then init_kb --region walloon
VECTOR_STORE_ID_WALLOON=
# Legacy fallback (optional): treated as VECTOR_STORE_ID_FLEMISH if set alone
# VECTOR_STORE_ID=

# Azure OpenAI deployment (optional — sensible defaults are baked in)
# AZURE_OPENAI_ENDPOINT=https://aidalh.cognitiveservices.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_INIT_KB_API_VERSION=2025-04-01-preview  # only override if vector-store upload needs a different API version than runtime

# Media preprocessing (1.7c — optional; defaults match previous hardcoded values)
# IMAGE_MAX_DIMENSION=2048
# IMAGE_JPEG_QUALITY=85
# IMAGE_AGGRESSIVE_MAX_DIMENSION=1280
# IMAGE_AGGRESSIVE_JPEG_QUALITY=70
# IMAGE_AGGRESSIVE_TRIGGER_MB=8
# UPLOAD_MAX_IMAGE_MB=20
# UPLOAD_MAX_TOTAL_MB=120
# UPLOAD_MAX_PAIRS=6

# Video preprocessing scaffold (1.7c — not wired to API yet; enforced in 1.8)
# VIDEO_MAX_DURATION_S=120
# VIDEO_MAX_FILE_MB=200
# VIDEO_MAX_FRAMES=8
# VIDEO_ACCEPTED_MIME=video/mp4,video/quicktime
# VIDEO_ACCEPTED_EXT=.mp4,.mov

# UI compression preset mapping (v1.7d — not wired yet; values hardcoded in app/api.py)
# COMPRESSION_PRESET_LOW_QUALITY=90
# COMPRESSION_PRESET_LOW_TARGET_MB=5
# COMPRESSION_PRESET_HIGH_QUALITY=65
# COMPRESSION_PRESET_HIGH_TARGET_MB=1
