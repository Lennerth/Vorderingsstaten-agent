AZURE_OPENAI_API_KEY=<your-azure-key>
LOG_DIR=logs
# Flemish bestek (Vlaams) — run: python -m scripts.init_kb --region flemish
VECTOR_STORE_ID_FLEMISH=
# Walloon CCTB — run: python -m scripts.build_walloon_master then init_kb --region walloon
VECTOR_STORE_ID_WALLOON=
# Legacy fallback (optional): treated as VECTOR_STORE_ID_FLEMISH if set alone
# VECTOR_STORE_ID=

# Azure OpenAI deployment (optional — sensible defaults are baked in)
# AZURE_OPENAI_ENDPOINT=https://aidalh.cognitiveservices.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_INIT_KB_API_VERSION=2025-04-01-preview  # only override if vector-store upload needs a different API version than runtime
